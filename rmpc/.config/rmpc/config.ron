#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    // MPD Connection
    address: "127.0.0.1:6600",
    password: None,
    
    // General UI Settings
    volume_step: 5,
    scrolloff: 2,
    max_fps: 60,
    wrap_navigation: true,
    cache_dir: "~/.mpd/cache",
    status_update_interval_ms: 1000,
    enable_mouse: true,
    enable_config_hot_reload: true,
    
    // Album Art Configuration (Configured for Kitty/WezTerm/Ghostty)
    album_art: (
        method: Block,
        max_size_px: (width: 400, height: 400),
        vertical_align: Center,
        horizontal_align: Center,
    ),
    
    // Optional: Cava Integration (Terminal Audio Visualizer)
    // To use this, you'll need `cava` installed and an audio fifo set up in mpd.conf
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 130,
        input: (
            method: Pulse, // Tells it to use system audio instead of MPD
            source: "auto", 
        ),
        smoothing: (
            noise_reduction: 25,
            monstercat: false,
            waves: false,
        ),
    ),
// Basic Global Keybinds
    keybinds: (
        global: {
            "q": Quit,
            "~": ShowHelp,
            "O": ShowOutputs,
            "I": ShowCurrentSongInfo,
            "<C-p>": ShowDecoders,
            ":": CommandMode,
        },
    ),

    // --- NEW: UI TABS & LAYOUT CONFIGURATION ---
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    // Left Half (50% Width): Queue
                    (
                        size: "50%",
                        pane: Pane(Queue),
                    ),
                    // Right Half (50% Width): Split Vertically
                    (
                        size: "50%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                // Upper Right (80% Height): Album Art
                                (
                                    size: "80%",
                                    pane: Pane(AlbumArt),
                                ),
                                // Lower Right (20% Height): Cava Panel
                                (
                                    size: "20%",
                                    borders: "TOP",
                                    pane: Pane(Cava),
                                ),
                            ]
                        )
                    ),
                ]
            )
        ),
        // Keep your other default tabs accessible
        (name: "Directories", pane: Pane(Directories)),
        (name: "Artists", pane: Pane(Artists)),
        (name: "Albums", pane: Pane(Albums)),
        (name: "Playlists", pane: Pane(Playlists)),
        (name: "Search", pane: Pane(Search)),
    ]
)
